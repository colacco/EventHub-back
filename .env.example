# App
PORT=3000

# Database (NestJS / Prisma)
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:DB_PORT/POSTGRES_DB"

# Database (Docker Compose)
# Usar porta 5433 se PostgreSQL nativo já estiver em 5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gerenciador_eventos
DB_PORT=5433

# JWT
JWT_SECRET="troque-por-um-segredo-aleatorio-e-longo"
JWT_EXPIRES_IN="7d"
